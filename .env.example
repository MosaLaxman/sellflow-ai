# ==============================================================================
# SellFlow AI — Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` and provide your real credentials.
# NEVER commit your actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM.
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
# Standard default PostgreSQL port is 5432 (or 5433 for dedicated instances):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sellflow?schema=public"

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Server-side API key for Google Gemini (Flash 1.5 / 2.0 / 2.5).
# Obtain from Google AI Studio: https://aistudio.google.com/
# NEVER expose this key to client-side code or NEXT_PUBLIC_* variables.
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 3. RAZORPAY TEST MODE API CREDENTIALS (Server-Side)
# ------------------------------------------------------------------------------
# Key ID and Key Secret from Razorpay Dashboard (Test Mode: Settings -> API Keys).
# RAZORPAY_KEY_SECRET MUST NEVER be shared with or exposed to the frontend.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# ------------------------------------------------------------------------------
# 4. RAZORPAY WEBHOOK SECRET (Server-Side)
# ------------------------------------------------------------------------------
# Webhook secret configured in the Razorpay Dashboard (Settings -> Webhooks).
# Used to cryptographically verify incoming HMAC SHA-256 signatures.
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# ------------------------------------------------------------------------------
# 5. PUBLIC CLIENT-SIDE RAZORPAY KEY
# ------------------------------------------------------------------------------
# Public Key ID required to initialize the client-side Razorpay Checkout modal.
# This must match RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# ------------------------------------------------------------------------------
# 6. APPLICATION BASE URL & AUTHENTICATION
# ------------------------------------------------------------------------------
# Base URL for webhook callbacks and redirection.
APP_URL="http://localhost:3000"

# Secret key used to sign and encrypt session cookies for merchant authentication.
# Generate a strong 32-character random string for production.
SESSION_SECRET="sellflow_super_secret_session_key_min_32_chars_long"

# ------------------------------------------------------------------------------
# 7. AI BUYER PROTOCOL API KEY (Optional)
# ------------------------------------------------------------------------------
# Secret key used for authenticating external AI buyer agents (Bearer token).
# Defaults to 'sfai_demo_buyer_key_2026' for demonstration if omitted.
SELLFLOW_BUYER_KEY="sfai_demo_buyer_key_2026"
